# --- Публічні (доступні в браузері) ---
NEXT_PUBLIC_SITE_URL=                   # напр. https://www.example.com — для canonical/OG
NEXT_PUBLIC_PAYMENT_URL=                # посилання на оплату (банка monobank тощо).
                                        # Потрібне для онлайн-оплати; післяплата працює й без нього
NEXT_PUBLIC_PREORDER_ENABLED=true       # "true" вмикає банер передзамовлення

# --- Google Sheets (опційно) ---
GOOGLE_SHEETS_SHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Orders
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=              # з \n замість реальних переносів рядка

# --- Telegram (опційно) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email через Resend (опційно) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=                      # адреса на верифікованому домені
RESEND_TO_EMAIL=
